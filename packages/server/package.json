{
  "name": "@great-minds/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test:integration": "vitest run test --no-file-parallelism",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1080.0",
    "@aws-sdk/s3-request-presigner": "3.1080.0",
    "@effect/ai-openai-compat": "4.0.0-beta.94",
    "@effect/ai-openrouter": "4.0.0-beta.94",
    "@effect/platform-node": "4.0.0-beta.94",
    "@effect/sql-pg": "4.0.0-beta.94",
    "@great-minds/database": "workspace:*",
    "@great-minds/domain": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "defuddle": "0.19.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.94",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.3",
    "jsdom": "29.1.1",
    "officeparser": "5.2.2",
    "undici": "8.10.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3"
  }
}
