{
  "name": "@great-minds/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "start": "node --experimental-strip-types src/main.ts",
    "sse-client": "node --experimental-strip-types src/sse-client.ts",
    "workflow": "node --experimental-strip-types src/workflow-runner.ts"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0-beta.94",
    "@effect/ai-openrouter": "4.0.0-beta.94",
    "@effect/platform-node": "4.0.0-beta.94",
    "@effect/sql-pg": "4.0.0-beta.94",
    "@great-minds/database": "workspace:*",
    "@great-minds/domain": "workspace:*",
    "effect": "4.0.0-beta.94"
  }
}
