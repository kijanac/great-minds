{
  "name": "@great-minds/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "migrate": "node --experimental-strip-types src/migrate-cli.ts",
    "ann": "node --experimental-strip-types src/ann-check.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-beta.94",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.94"
  }
}
