# Copy to .env.local. The local file is ignored and must never be committed.
# Provider-backed research and compile checks remain blocked when this is blank.
OPENROUTER_API_KEY=

# Optional web-search provider. Most owner-path verification does not require it.
PARALLEL_API_KEY=

# Override only when the source repository is elsewhere.
# GM_SOURCE_ROOT=/absolute/path/to/great_minds
